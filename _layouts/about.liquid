---
layout: default
---
<div class="home-sections">
  <section id="about" class="home-section home-intro" aria-labelledby="home-name">
    <div>
      <p class="home-role">{{ page.role }}</p>
      <h1 id="home-name">
        {{ site.first_name }}
        {{ site.last_name }}
        <span lang="zh-Hans">{{ page.name_zh }}</span>
      </h1>
      <div class="home-bio">{{ content }}</div>
      {% if page.social %}
        {% assign socials = site.data.socials %}
        <ul class="home-contact">
          {% if socials.email %}
            <li><a href="mailto:{{ socials.email | encode_email }}">Email</a></li>
          {% endif %}
          {% if socials.scholar_userid %}
            <li><a href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}">Google Scholar</a></li>
          {% endif %}
          {% if socials.github_username %}
            <li><a href="https://github.com/{{ socials.github_username }}">GitHub</a></li>
          {% endif %}
          {% if socials.rss_icon %}
            <li><a href="{{ '/feed.xml' | relative_url }}">RSS</a></li>
          {% endif %}
        </ul>
      {% endif %}
    </div>
    {% if page.portrait %}
      <img
        class="home-portrait"
        src="{{ page.portrait | relative_url | bust_file_cache }}"
        alt="Portrait of {{ site.first_name }} {{ site.last_name }}"
        width="640"
        height="800"
      >
    {% endif %}
  </section>

  {% if page.announcements.enabled %}
    <section id="news" class="home-section" aria-labelledby="home-news">
      <div class="home-section-heading">
        <h2 id="home-news">News</h2>
        {% if page.announcements.limit and site.news.size > page.announcements.limit %}
          <a href="{{ '/news/' | relative_url }}">All news &rarr;</a>
        {% endif %}
      </div>
      {% include news.liquid limit=true date_format='%b %Y' %}
    </section>
  {% endif %}

  {% if page.research %}
    <section id="research" class="home-section" aria-labelledby="home-research">
      <h2 id="home-research">Research</h2>
      <div class="home-research">
        {% for topic in page.research %}
          <article>
            <h3>{{ topic.title }}</h3>
            <p>{{ topic.description }}</p>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% assign experience = site.data.cv | where: 'title', 'Experience' | first %}
  {% if experience.contents %}
    <section id="experience" class="home-section" aria-labelledby="home-experience">
      <h2 id="home-experience">Experience</h2>
      <ul class="home-experience">
        {% for position in experience.contents %}
          <li>
            <div>
              <h3>{{ position.institution }}</h3>
              <p>{{ position.title }}</p>
            </div>
            <span>{{ position.year }}</span>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section id="publications" class="home-section" aria-labelledby="home-publications">
      <div class="home-section-heading">
        <h2 id="home-publications">Selected Publications</h2>
        <a href="{{ '/publications/' | relative_url }}">All publications &rarr;</a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}
</div>
