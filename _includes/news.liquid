<div class="news table-responsive">
  <table class="table table-sm table-borderless">
    {% assign news = site.news | reverse %}
    {% for item in news %}
      <tr id="{{ item.url | split: '#' | last | escape }}">
        <th scope="row" style="width: var(--news-date-width, 20%)">
          <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
        </th>
        <td>{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</td>
      </tr>
    {% endfor %}
  </table>
</div>
